{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (avra)",
      "type": "shell",
      "command": "./build.sh",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": {
        "owner": "avra",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+?)\\((\\d+)\\)\\s*:\\s*(Error|Warning)\\s*:\\s*(.+)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    },
    {
      "label": "Clean build (avra)",
      "type": "shell",
      "command": "./build.sh",
      "args": ["--clean"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
